# MiseAi Environment Variables
# Copy this file to .env and replace placeholders with real values

# API key for the LLM used for shorthand expansion and metadata inference.
# Named GROQ_* because the default free option is Groq's OpenAI-compatible API
# (see GROQ_BASE_URL below). Leave unset/placeholder to run glossary-only (no LLM calls, fully free).
GROQ_API_KEY=your-groq-api-key-here

# Model to use for text cleaning/expansion.
# Groq free tier: openai/gpt-oss-120b (check https://console.groq.com/docs/models
# for the current free-tier model list — model names on Groq change over time).
# If you switch to real OpenAI instead, use gpt-4o-mini and unset GROQ_BASE_URL.
GROQ_MODEL=openai/gpt-oss-120b

# Optional: point at any OpenAI-compatible endpoint. Leave unset to use OpenAI directly.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: Tesseract OCR binary path (required for scanned PDF support)
# macOS default: /opt/homebrew/bin/tesseract
# Linux default: /usr/bin/tesseract
TESSERACT_CMD=tesseract

# Max files allowed per upload session
MAX_FILES=5

# Max file size in MB per upload
MAX_FILE_SIZE_MB=20

# Output directory for future/custom runners (relative to project root).
# The current Streamlit app uses output/ via PipelineConfig in app.py.
OUTPUT_DIR=output
